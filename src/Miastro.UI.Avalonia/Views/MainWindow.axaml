<Window
    x:Class="Miastro.UI.Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Miastro.UI.Avalonia.ViewModels"
    xmlns:reading="using:Miastro.Application.Natal.Reading"
    xmlns:panelvm="using:Miastro.UI.Avalonia.ViewModels.NatalPanels"
    x:DataType="vm:MainWindowViewModel"
    Width="1180"
    Height="760"
    MinWidth="900"
    MinHeight="620"
    Title="{Binding Title}"
    KeyDown="OnMainWindowKeyDown">

    <Grid
        RowDefinitions="Auto,*,Auto"
        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">

        <Border
            Grid.Row="0"
            Padding="20,14"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="20">

                <StackPanel
                    Grid.Column="0"
                    Spacing="2">

                    <TextBlock
                        Text="Miastro"
                        FontSize="24"
                        FontWeight="SemiBold" />

                    <TextBlock
                        Text="Personas"
                        Opacity="0.7" />

                </StackPanel>

                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding Language}"
                    Opacity="0.65" />

            </Grid>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="20"
            ColumnDefinitions="340,*"
            ColumnSpacing="20">

            <Border
                Grid.Column="0"
                Padding="16"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

                <Grid
                    RowDefinitions="Auto,Auto,Auto,*,Auto"
                    RowSpacing="12">

                    <TextBlock
                        Grid.Row="0"
                        Text="Personas"
                        FontSize="20"
                        FontWeight="SemiBold" />

                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">

                        <TextBox
                            Grid.Column="0"
                            PlaceholderText="Buscar por nombre o apellidos"
                            Text="{Binding SearchText}" />

                        <Button
                            Grid.Column="1"
                            Content="Buscar"
                            Command="{Binding SearchCommand}" />

                    </Grid>

                    <Grid
                        Grid.Row="2"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="8">

                        <ComboBox
                            Grid.Column="0"
                            ItemsSource="{Binding Filters}"
                            SelectedItem="{Binding SelectedFilter}" />

                        <ComboBox
                            Grid.Column="1"
                            ItemsSource="{Binding SortChoices}"
                            SelectedItem="{Binding SelectedSort}" />

                    </Grid>

                    <ListBox
                        Grid.Row="3"
                        ItemsSource="{Binding People}"
                        SelectedItem="{Binding SelectedPerson}">

                        <ListBox.ItemTemplate>
                            <DataTemplate
                                x:DataType="vm:PersonListRowViewModel">

                                <Grid
                                    Margin="4"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="8">

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{Binding FavoriteMark}"
                                        FontSize="16"
                                        VerticalAlignment="Top" />

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="2">

                                        <TextBlock
                                            Text="{Binding DisplayName}"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Text="{Binding LastConsultationText}"
                                            FontSize="12"
                                            Opacity="0.65" />

                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid
                        Grid.Row="4"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="8">

                        <Button
                            Grid.Column="0"
                            Content="Nueva persona"
                            Command="{Binding NewPersonCommand}" />

                        <Button
                            Grid.Column="1"
                            Content="Abrir"
                            Command="{Binding OpenSelectedCommand}" />

                    </Grid>

                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="22"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

                <Grid>

                    <StackPanel
                        IsVisible="{Binding !IsEditorVisible}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">

                        <TextBlock
                            Text="Selecciona una persona"
                            FontSize="22"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />

                        <TextBlock
                            Text="o crea una ficha nueva"
                            Opacity="0.7"
                            HorizontalAlignment="Center" />

                    </StackPanel>

                    <ScrollViewer
                        IsVisible="{Binding IsEditorVisible}">

                        <StackPanel
                            Spacing="18">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">

                                <StackPanel
                                    Grid.Column="0"
                                    Spacing="4">

                                    <TextBlock
                                        Text="{Binding EditorTitle}"
                                        FontSize="22"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        Text="{Binding LastConsultationText}"
                                        Opacity="0.65" />

                                </StackPanel>

                                <CheckBox
                                    Grid.Column="1"
                                    Content="Favorita"
                                    IsChecked="{Binding IsFavorite}"
                                    VerticalAlignment="Center" />

                            </Grid>

                            <Border
                                Padding="16"
                                CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                                <StackPanel
                                    Spacing="12">

                                    <TextBlock
                                        Text="Identidad"
                                        FontSize="17"
                                        FontWeight="SemiBold" />

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="12">

                                        <StackPanel
                                            Grid.Column="0"
                                            Spacing="4">

                                            <TextBlock
                                                Text="Nombre" />

                                            <TextBox
                                                Text="{Binding FirstName}"
                                                PlaceholderText="Nombre"
                                                AutomationProperties.Name="Nombre" />

                                            <TextBlock
                                                IsVisible="{Binding HasFirstNameError}"
                                                Text="{Binding FirstNameError}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="4">

                                            <TextBlock
                                                Text="Apellidos" />

                                            <TextBox
                                                Text="{Binding LastName}"
                                                PlaceholderText="Apellidos"
                                                AutomationProperties.Name="Apellidos" />

                                            <TextBlock
                                                IsVisible="{Binding HasLastNameError}"
                                                Text="{Binding LastNameError}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <Border
                                Padding="16"
                                CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                                <StackPanel
                                    Spacing="12">

                                    <TextBlock
                                        Text="Contacto"
                                        FontSize="17"
                                        FontWeight="SemiBold" />

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="12">

                                        <StackPanel
                                            Grid.Column="0"
                                            Spacing="4">

                                            <TextBlock
                                                Text="Teléfono" />

                                            <TextBox
                                                Text="{Binding Phone}"
                                                PlaceholderText="Opcional" />

                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="4">

                                            <TextBlock
                                                Text="Email" />

                                            <TextBox
                                                Text="{Binding Email}"
                                                PlaceholderText="Opcional"
                                                AutomationProperties.Name="Email" />

                                            <TextBlock
                                                IsVisible="{Binding HasEmailError}"
                                                Text="{Binding EmailError}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                                        </StackPanel>

                                    </Grid>

                                    <TextBlock
                                        Text="Nota privada" />

                                    <TextBox
                                        Text="{Binding PrivateNote}"
                                        AcceptsReturn="True"
                                        MinHeight="100"
                                        TextWrapping="Wrap"
                                        PlaceholderText="Notas privadas de la ficha" />

                                </StackPanel>
                            </Border>

                            <Border
                                Padding="16"
                                CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                                <StackPanel Spacing="12">

                                    <CheckBox
                                        Content="Añadir datos de nacimiento"
                                        IsChecked="{Binding HasBirthData}" />

                                    <StackPanel
                                        IsVisible="{Binding HasBirthData}"
                                        Spacing="12">

                                        <TextBlock
                                            Text="Nacimiento"
                                            FontSize="17"
                                            FontWeight="SemiBold" />

                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="12">

                                            <StackPanel
                                                Grid.Column="0"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Fecha" />

                                                <DatePicker
                                                    SelectedDate="{Binding BirthDate}"
                                                    AutomationProperties.Name="Fecha de nacimiento" />

                                                <TextBlock
                                                    IsVisible="{Binding HasBirthDateError}"
                                                    Text="{Binding BirthDateError}"
                                                    TextWrapping="Wrap"
                                                    Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="4">

                                                <TextBlock
                                                    Text="Precisión de la hora" />

                                                <ComboBox
                                                    ItemsSource="{Binding BirthPrecisionChoices}"
                                                    SelectedItem="{Binding SelectedBirthPrecision}" />

                                            </StackPanel>

                                        </Grid>

                                        <StackPanel
                                            IsVisible="{Binding IsConcreteBirthTime}"
                                            Spacing="4">

                                            <TextBlock
                                                Text="Hora local" />

                                            <TextBox
                                                Text="{Binding BirthTimeText}"
                                                PlaceholderText="HH:mm"
                                                AutomationProperties.Name="Hora de nacimiento" />

                                            <TextBlock
                                                IsVisible="{Binding HasBirthTimeError}"
                                                Text="{Binding BirthTimeError}"
                                                TextWrapping="Wrap"
                                                Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                                        </StackPanel>

                                        <Grid
                                            IsVisible="{Binding IsBirthRange}"
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="12">

                                            <StackPanel
                                                Grid.Column="0"
                                                Spacing="4">

                                                <TextBlock Text="Desde" />

                                                <TextBox
                                                    Text="{Binding BirthRangeStartText}"
                                                    PlaceholderText="HH:mm" />

                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="1"
                                                Spacing="4">

                                                <TextBlock Text="Hasta" />

                                                <TextBox
                                                    Text="{Binding BirthRangeEndText}"
                                                    PlaceholderText="HH:mm" />

                                            </StackPanel>

                                        </Grid>

                                        <StackPanel
                                            IsVisible="{Binding IsBirthDayPeriod}"
                                            Spacing="4">

                                            <TextBlock
                                                Text="Momento del día" />

                                            <ComboBox
                                                ItemsSource="{Binding DayPeriodChoices}"
                                                SelectedItem="{Binding SelectedDayPeriod}" />

                                        </StackPanel>

                                        <TextBlock
                                            Text="Lugar de nacimiento"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Text="{Binding BirthLocationDisplay}"
                                            TextWrapping="Wrap"
                                            Opacity="0.75" />

                                        <TextBlock
                                            IsVisible="{Binding HasBirthLocationError}"
                                            Text="{Binding BirthLocationError}"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="8">

                                            <TextBox
                                                Grid.Column="0"
                                                Text="{Binding BirthLocationSearchText}"
                                                PlaceholderText="Buscar localidad" />

                                            <Button
                                                Grid.Column="1"
                                                Content="Buscar localidad"
                                                Command="{Binding SearchBirthLocationCommand}" />

                                        </Grid>

                                        <ListBox
                                            MaxHeight="170"
                                            ItemsSource="{Binding BirthLocationResults}"
                                            SelectedItem="{Binding SelectedBirthSearchResult}">

                                            <ListBox.ItemTemplate>
                                                <DataTemplate
                                                    x:DataType="vm:LocationResultViewModel">

                                                    <TextBlock
                                                        Margin="4"
                                                        Text="{Binding DisplayName}"
                                                        TextWrapping="Wrap" />

                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>

                                        <Button
                                            HorizontalAlignment="Left"
                                            Content="Usar localidad seleccionada"
                                            Command="{Binding SelectBirthLocationCommand}" />

                                        <StackPanel
                                            IsVisible="{Binding IsConcreteBirthTime}"
                                            Spacing="8">

                                            <Button
                                                HorizontalAlignment="Left"
                                                Content="Resolver hora histórica"
                                                Command="{Binding ResolveBirthTimeCommand}" />

                                            <TextBlock
                                                Text="{Binding BirthResolutionMessage}"
                                                TextWrapping="Wrap" />

                                            <Grid
                                                IsVisible="{Binding BirthAmbiguous}"
                                                ColumnDefinitions="Auto,Auto"
                                                ColumnSpacing="8">

                                                <Button
                                                    Grid.Column="0"
                                                    Content="Elegir primera posibilidad"
                                                    Command="{Binding ChooseEarlierAmbiguousTimeCommand}" />

                                                <Button
                                                    Grid.Column="1"
                                                    Content="Elegir segunda posibilidad"
                                                    Command="{Binding ChooseLaterAmbiguousTimeCommand}" />

                                            </Grid>

                                        </StackPanel>

                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <Border
                                Padding="16"
                                CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                                <StackPanel Spacing="12">

                                    <CheckBox
                                        Content="Añadir residencia actual"
                                        IsChecked="{Binding HasResidence}" />

                                    <StackPanel
                                        IsVisible="{Binding HasResidence}"
                                        Spacing="10">

                                        <TextBlock
                                            Text="Residencia actual"
                                            FontSize="17"
                                            FontWeight="SemiBold" />

                                        <TextBlock
                                            Text="{Binding ResidenceLocationDisplay}"
                                            TextWrapping="Wrap"
                                            Opacity="0.75" />

                                        <TextBlock
                                            IsVisible="{Binding HasResidenceLocationError}"
                                            Text="{Binding ResidenceLocationError}"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="8">

                                            <TextBox
                                                Grid.Column="0"
                                                Text="{Binding ResidenceLocationSearchText}"
                                                PlaceholderText="Buscar localidad" />

                                            <Button
                                                Grid.Column="1"
                                                Content="Buscar localidad"
                                                Command="{Binding SearchResidenceLocationCommand}" />

                                        </Grid>

                                        <ListBox
                                            MaxHeight="170"
                                            ItemsSource="{Binding ResidenceLocationResults}"
                                            SelectedItem="{Binding SelectedResidenceSearchResult}">


                                            <ListBox.ItemTemplate>
                                                <DataTemplate
                                                    x:DataType="vm:LocationResultViewModel">

                                                    <TextBlock
                                                        Margin="4"
                                                        Text="{Binding DisplayName}"
                                                        TextWrapping="Wrap" />

                                                </DataTemplate>
                                            </ListBox.ItemTemplate>

                                        </ListBox>

                                        <Button
                                            HorizontalAlignment="Left"
                                            Content="Usar residencia seleccionada"
                                            Command="{Binding SelectResidenceLocationCommand}" />

                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <Border
                                IsVisible="{Binding IsNatalSectionVisible}"
                                Padding="16"
                                CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                                <StackPanel Spacing="12">

                                    <TextBlock
                                        Text="Carta natal"
                                        FontSize="17"
                                        FontWeight="SemiBold" />

                                    <Border
                                        Name="NatalDataPanel"
                                        Padding="10"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        AutomationProperties.Name="Datos natales">

                                        <StackPanel
                                            Spacing="4">

                                            <TextBlock
                                                Text="Datos"
                                                FontWeight="SemiBold" />

                                            <TextBlock
                                                Text="{Binding NatalAvailabilityText}"
                                                FontWeight="SemiBold"
                                                TextWrapping="Wrap" />

                                            <TextBlock
                                                Text="{Binding NatalStatusMessage}"
                                                TextWrapping="Wrap"
                                                Opacity="0.75" />

                                            <TextBlock
                                                IsVisible="{Binding HasCurrentNatalChart}"
                                                Text="{Binding NatalCalculatedAtText}"
                                                Opacity="0.75" />

                                            <TextBlock
                                                IsVisible="{Binding HasCurrentNatalChart}"
                                                Text="{Binding CurrentNatalHouseSystemText}"
                                                Opacity="0.75" />

                                        </StackPanel>

                                    </Border>

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12">

                                        <StackPanel
                                            Grid.Column="0"
                                            Spacing="4">

                                            <TextBlock
                                                Text="Sistema de casas" />

                                            <ComboBox
                                                ItemsSource="{Binding NatalHouseSystems}"
                                                SelectedItem="{Binding SelectedNatalHouseSystem}"
                                                AutomationProperties.Name="Sistema de casas natal" />

                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Content="Calcular carta natal"
                                            Command="{Binding CalculateNatalCommand}"
                                            AutomationProperties.Name="Calcular carta natal" />

                                    </Grid>

                                    <TextBlock
                                        IsVisible="{Binding NatalCalculationFailed}"
                                        Text="{Binding NatalStatusMessage}"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                                    <Border
                                        IsVisible="{Binding HasNatalWheel}"
                                        Padding="12"
                                        CornerRadius="8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

                                        <StackPanel
                                            Spacing="8">

                                            <TextBlock
                                                Text="Rueda natal"
                                                FontSize="16"
                                                FontWeight="SemiBold" />

                                            <Grid
                                                ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                                                ColumnSpacing="10">

                                                <CheckBox
                                                    Grid.Column="0"
                                                    Content="Planetas"
                                                    IsChecked="{Binding ShowNatalPlanets}" />

                                                <CheckBox
                                                    Grid.Column="1"
                                                    Content="Puntos"
                                                    IsChecked="{Binding ShowNatalPoints}" />

                                                <CheckBox
                                                    Grid.Column="2"
                                                    Content="Aspectos"
                                                    IsChecked="{Binding ShowNatalAspects}" />

                                                <CheckBox
                                                    Grid.Column="3"
                                                    Content="Cúspides"
                                                    IsChecked="{Binding ShowNatalCusps}" />

                                                <CheckBox
                                                    Grid.Column="4"
                                                    Content="Etiquetas"
                                                    IsChecked="{Binding ShowNatalLabels}" />

                                                <ComboBox
                                                    Grid.Column="5"
                                                    HorizontalAlignment="Right"
                                                    MinWidth="150"
                                                    ItemsSource="{Binding NatalWheelModes}"
                                                    SelectedItem="{Binding SelectedNatalWheelMode}" />

                                            </Grid>

                                            <Grid
                                                Name="NatalWheelPanelLayout"
                                                ColumnDefinitions="*,Auto"
                                                ColumnSpacing="14"
                                                SizeChanged="OnNatalWheelPanelLayoutSizeChanged">

                                                <Border
                                                    Name="NatalWheelViewportHost"
                                                    Grid.Column="0"
                                                    MinWidth="280"
                                                    HorizontalAlignment="Stretch"
                                                    SizeChanged="OnNatalWheelViewportHostSizeChanged">

                                                    <Image
                                                        Name="NatalWheelImage"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Stretch="Uniform"
                                                        Source="{Binding NatalWheelBitmap}"
                                                        Focusable="True"
                                                        TabIndex="0"
                                                        PointerMoved="OnNatalWheelPointerMoved"
                                                        PointerExited="OnNatalWheelPointerExited"
                                                        PointerPressed="OnNatalWheelPointerPressed"
                                                        ToolTip.Tip="{Binding NatalWheelTooltipText}"
                                                        ToolTip.ShowDelay="200"
                                                        KeyDown="OnNatalWheelKeyDown"
                                                        AutomationProperties.Name="Rueda natal interactiva"
                                                        AutomationProperties.HelpText="{Binding NatalWheelAccessibilityText}" />

                                                </Border>

                                                <StackPanel
                                                    Name="NatalPhase8PanelShell"
                                                    Grid.Column="1"
                                                    Spacing="6"
                                                    HorizontalAlignment="Right"
                                                    IsVisible="{Binding HasNatalPanels}">

                                                    <Button
                                                        Name="NatalPhase8PanelToggleButton"
                                                        HorizontalAlignment="Right"
                                                        Content="Ocultar panel"
                                                        Click="OnNatalPhase8PanelToggleClick"
                                                        AutomationProperties.Name="Mostrar u ocultar panel natal"
                                                        AutomationProperties.HelpText="Permite dar más espacio a la rueda natal." />

                                                    <Border
                                                        Name="NatalPhase8PanelHost"
                                                        Width="360"
                                                        MinWidth="300"
                                                        MaxWidth="420"
                                                        Padding="10"
                                                        CornerRadius="6"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                                        AutomationProperties.Name="Panel natal de consulta">

                                                    <TabControl
                                                        Name="NatalPhase8PanelTabs"
                                                        SelectedIndex="{Binding NatalPanels.SelectedIndex, Mode=TwoWay}"
                                                        AutomationProperties.Name="Paneles natales">

                                                        <TabItem
                                                            Header="Datos"
                                                            AutomationProperties.Name="Datos">

                                                            <ScrollViewer
                                                                VerticalScrollBarVisibility="Auto"
                                                                HorizontalScrollBarVisibility="Auto">

                                                                <StackPanel
                                                                    Margin="4"
                                                                    Spacing="5">

                                                                    <Grid
                                                                        ColumnDefinitions="42,1.35*,72,1*,1.35*"
                                                                        ColumnSpacing="8"
                                                                        Margin="4,0,4,3">

                                                                        <TextBlock
                                                                            Grid.Column="0"
                                                                            Text="Glifo"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold" />

                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Text="Nombre"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold" />

                                                                        <TextBlock
                                                                            Grid.Column="2"
                                                                            Text="Grado"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold" />

                                                                        <TextBlock
                                                                            Grid.Column="3"
                                                                            Text="Signo"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold" />

                                                                        <TextBlock
                                                                            Grid.Column="4"
                                                                            Text="Regente"
                                                                            FontSize="11"
                                                                            FontWeight="SemiBold" />

                                                                    </Grid>

                                                                    <ListBox
                                                                        Name="NatalDataList"
                                                                        ItemsSource="{Binding NatalPanels.Data.Rows}"
                                                                        SelectedItem="{Binding NatalPanels.SelectedDataRow, Mode=TwoWay}"
                                                                        SelectionMode="Single"
                                                                        AutomationProperties.Name="Datos natales">

                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate
                                                                                x:DataType="reading:NatalDataRowReadModel">

                                                                                <Border
                                                                                    Padding="4,7"
                                                                                    BorderThickness="0,0,0,1"
                                                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                    AutomationProperties.Name="{Binding AccessibleName}">

                                                                                    <Grid
                                                                                        ColumnDefinitions="42,1.35*,72,1*,1.35*"
                                                                                        ColumnSpacing="8">

                                                                                        <TextBlock
                                                                                            Grid.Column="0"
                                                                                            Text="{Binding GlyphText}"
                                                                                            FontSize="17"
                                                                                            FontWeight="SemiBold"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center" />

                                                                                        <StackPanel
                                                                                            Grid.Column="1"
                                                                                            Spacing="1">

                                                                                            <TextBlock
                                                                                                Text="{Binding ObjectName}"
                                                                                                FontWeight="SemiBold"
                                                                                                TextWrapping="Wrap" />

                                                                                            <TextBlock
                                                                                                Text="ÁNGULO"
                                                                                                IsVisible="{Binding IsAngle}"
                                                                                                FontSize="9"
                                                                                                FontWeight="SemiBold" />

                                                                                        </StackPanel>

                                                                                        <TextBlock
                                                                                            Grid.Column="2"
                                                                                            Text="{Binding DegreeText}"
                                                                                            VerticalAlignment="Center" />

                                                                                        <TextBlock
                                                                                            Grid.Column="3"
                                                                                            Text="{Binding SignName}"
                                                                                            TextWrapping="Wrap"
                                                                                            VerticalAlignment="Center" />

                                                                                        <TextBlock
                                                                                            Grid.Column="4"
                                                                                            Text="{Binding SignRulersText}"
                                                                                            TextWrapping="Wrap"
                                                                                            VerticalAlignment="Center" />

                                                                                    </Grid>

                                                                                </Border>

                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>

                                                                    </ListBox>

                                                                </StackPanel>

                                                            </ScrollViewer>

                                                        </TabItem>

                                                        <TabItem
                                                            Header="Posiciones"
                                                            AutomationProperties.Name="Posiciones">

                                                            <ScrollViewer
                                                                VerticalScrollBarVisibility="Auto"
                                                                HorizontalScrollBarVisibility="Auto">

                                                                <StackPanel
                                                                    Margin="4"
                                                                    Spacing="5">

                                                                    <TextBlock
                                                                        Text="Selecciona una fila para sincronizarla con la rueda. Expande para consultar los datos técnicos."
                                                                        FontSize="11"
                                                                        TextWrapping="Wrap" />

                                                                    <ListBox
                                                                        Name="NatalPositionsList"
                                                                        ItemsSource="{Binding NatalPanels.Positions.Rows}"
                                                                        SelectedItem="{Binding NatalPanels.SelectedPositionRow, Mode=TwoWay}"
                                                                        SelectionMode="Single"
                                                                        AutomationProperties.Name="Posiciones natales">

                                                                        <ListBox.ItemTemplate>
                                                                            <DataTemplate
                                                                                x:DataType="reading:NatalPositionRowReadModel">

                                                                                <Border
                                                                                    Padding="4,6"
                                                                                    BorderThickness="0,0,0,1"
                                                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                    AutomationProperties.Name="{Binding AccessibleName}">

                                                                                    <Expander
                                                                                        HorizontalAlignment="Stretch">

                                                                                        <Expander.Header>
                                                                                            <Grid
                                                                                                ColumnDefinitions="42,1.25*,1.45*,92,90"
                                                                                                ColumnSpacing="7"
                                                                                                MinWidth="490">

                                                                                                <TextBlock
                                                                                                    Grid.Column="0"
                                                                                                    Text="{Binding GlyphText}"
                                                                                                    FontSize="17"
                                                                                                    FontWeight="SemiBold"
                                                                                                    HorizontalAlignment="Center"
                                                                                                    VerticalAlignment="Center" />

                                                                                                <StackPanel
                                                                                                    Grid.Column="1"
                                                                                                    Spacing="1">

                                                                                                    <TextBlock
                                                                                                        Text="{Binding ObjectName}"
                                                                                                        FontWeight="SemiBold"
                                                                                                        TextWrapping="Wrap" />

                                                                                                    <TextBlock
                                                                                                        Text="ÁNGULO"
                                                                                                        IsVisible="{Binding IsAngle}"
                                                                                                        FontSize="9"
                                                                                                        FontWeight="SemiBold" />

                                                                                                </StackPanel>

                                                                                                <TextBlock
                                                                                                    Grid.Column="2"
                                                                                                    Text="{Binding ExactPositionText}"
                                                                                                    TextWrapping="Wrap"
                                                                                                    VerticalAlignment="Center" />

                                                                                                <TextBlock
                                                                                                    Grid.Column="3"
                                                                                                    Text="{Binding HouseText}"
                                                                                                    VerticalAlignment="Center" />

                                                                                                <TextBlock
                                                                                                    Grid.Column="4"
                                                                                                    Text="{Binding MotionText}"
                                                                                                    TextWrapping="Wrap"
                                                                                                    VerticalAlignment="Center" />

                                                                                            </Grid>
                                                                                        </Expander.Header>

                                                                                        <Border
                                                                                            Margin="42,6,0,2"
                                                                                            Padding="8"
                                                                                            BorderThickness="1"
                                                                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                            CornerRadius="4">

                                                                                            <Grid
                                                                                                ColumnDefinitions="Auto,*"
                                                                                                RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                                                                                ColumnSpacing="12"
                                                                                                RowSpacing="5">

                                                                                                <TextBlock
                                                                                                    Grid.Row="0"
                                                                                                    Grid.Column="0"
                                                                                                    Text="Posición exacta"
                                                                                                    FontWeight="SemiBold" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="0"
                                                                                                    Grid.Column="1"
                                                                                                    Text="{Binding ExactPositionText}"
                                                                                                    TextWrapping="Wrap" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="1"
                                                                                                    Grid.Column="0"
                                                                                                    Text="Casa"
                                                                                                    FontWeight="SemiBold" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="1"
                                                                                                    Grid.Column="1"
                                                                                                    Text="{Binding HouseText}" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="2"
                                                                                                    Grid.Column="0"
                                                                                                    Text="Regente(s) del signo"
                                                                                                    FontWeight="SemiBold" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="2"
                                                                                                    Grid.Column="1"
                                                                                                    Text="{Binding SignRulersText}"
                                                                                                    TextWrapping="Wrap" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="3"
                                                                                                    Grid.Column="0"
                                                                                                    Text="Signo de la cúspide"
                                                                                                    FontWeight="SemiBold" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="3"
                                                                                                    Grid.Column="1"
                                                                                                    Text="{Binding HouseCuspSignText}"
                                                                                                    TextWrapping="Wrap" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="4"
                                                                                                    Grid.Column="0"
                                                                                                    Text="Regente(s) de la casa"
                                                                                                    FontWeight="SemiBold" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="4"
                                                                                                    Grid.Column="1"
                                                                                                    Text="{Binding HouseRulersText}"
                                                                                                    TextWrapping="Wrap" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="5"
                                                                                                    Grid.Column="0"
                                                                                                    Text="Movimiento"
                                                                                                    FontWeight="SemiBold" />

                                                                                                <TextBlock
                                                                                                    Grid.Row="5"
                                                                                                    Grid.Column="1"
                                                                                                    Text="{Binding MotionText}" />

                                                                                            </Grid>

                                                                                        </Border>

                                                                                    </Expander>

                                                                                </Border>

                                                                            </DataTemplate>
                                                                        </ListBox.ItemTemplate>

                                                                    </ListBox>

                                                                </StackPanel>

                                                            </ScrollViewer>

                                                        </TabItem>

                                                        <TabItem
                                                            Header="Aspectos"
                                                            AutomationProperties.Name="Aspectos">

                                                            <ScrollViewer
                                                                VerticalScrollBarVisibility="Auto"
                                                                HorizontalScrollBarVisibility="Auto">

                                                                <StackPanel
                                                                    Margin="4"
                                                                    Spacing="10">

                                                                    <TextBlock
                                                                        Text="Matriz de aspectos"
                                                                        FontWeight="SemiBold" />

                                                                    <Border
                                                                        Padding="6"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                        CornerRadius="4">

                                                                        <StackPanel
                                                                            Spacing="4">

                                                                            <StackPanel
                                                                                Orientation="Horizontal"
                                                                                Spacing="2">

                                                                                <Border
                                                                                    Width="92"
                                                                                    Height="42" />

                                                                                <ItemsControl
                                                                                    ItemsSource="{Binding NatalPanels.Aspects.Columns}">

                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel
                                                                                                Orientation="Horizontal"
                                                                                                Spacing="2" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>

                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate
                                                                                            x:DataType="panelvm:NatalAspectMatrixColumnViewModel">

                                                                                            <Border
                                                                                                Width="58"
                                                                                                MinHeight="42"
                                                                                                Padding="2"
                                                                                                VerticalAlignment="Stretch">

                                                                                                <TextBlock
                                                                                                    Text="{Binding ObjectName}"
                                                                                                    FontSize="11"
                                                                                                    TextAlignment="Center"
                                                                                                    TextWrapping="Wrap"
                                                                                                    VerticalAlignment="Center" />

                                                                                            </Border>

                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>

                                                                                </ItemsControl>

                                                                            </StackPanel>

                                                                            <ItemsControl
                                                                                Name="NatalAspectTriangularMatrix"
                                                                                ItemsSource="{Binding NatalPanels.Aspects.Rows}"
                                                                                AutomationProperties.Name="Matriz triangular de aspectos natales"
                                                                                AutomationProperties.HelpText="Tab recorre las celdas con aspecto. Enter o espacio selecciona. Escape limpia la selección.">

                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate
                                                                                        x:DataType="panelvm:NatalAspectMatrixRowViewModel">

                                                                                        <StackPanel
                                                                                            Orientation="Horizontal"
                                                                                            Spacing="2">

                                                                                            <Border
                                                                                                Width="92"
                                                                                                MinHeight="52"
                                                                                                Padding="4">

                                                                                                <TextBlock
                                                                                                    Text="{Binding ObjectName}"
                                                                                                    FontSize="11"
                                                                                                    FontWeight="SemiBold"
                                                                                                    TextWrapping="Wrap"
                                                                                                    VerticalAlignment="Center" />

                                                                                            </Border>

                                                                                            <ItemsControl
                                                                                                ItemsSource="{Binding Cells}">

                                                                                                <ItemsControl.ItemsPanel>
                                                                                                    <ItemsPanelTemplate>
                                                                                                        <StackPanel
                                                                                                            Orientation="Horizontal"
                                                                                                            Spacing="2" />
                                                                                                    </ItemsPanelTemplate>
                                                                                                </ItemsControl.ItemsPanel>

                                                                                                <ItemsControl.ItemTemplate>
                                                                                                    <DataTemplate
                                                                                                        x:DataType="reading:NatalAspectMatrixCell">

                                                                                                        <Button
                                                                                                            Width="58"
                                                                                                            Height="52"
                                                                                                            Padding="2"
                                                                                                            IsEnabled="{Binding HasAspect}"
                                                                                                            Click="OnNatalAspectMatrixCellClick"
                                                                                                            AutomationProperties.Name="{Binding AccessibleName}"
                                                                                                            AutomationProperties.HelpText="{Binding AccessibleName}"
                                                                                                            ToolTip.Tip="{Binding AccessibleName}">

                                                                                                            <StackPanel
                                                                                                                HorizontalAlignment="Center"
                                                                                                                VerticalAlignment="Center"
                                                                                                                Spacing="1">

                                                                                                                <TextBlock
                                                                                                                    Text="{Binding AspectSymbol}"
                                                                                                                    FontSize="17"
                                                                                                                    FontWeight="SemiBold"
                                                                                                                    HorizontalAlignment="Center" />

                                                                                                                <TextBlock
                                                                                                                    Text="{Binding OrbText}"
                                                                                                                    FontSize="9"
                                                                                                                    HorizontalAlignment="Center" />

                                                                                                            </StackPanel>

                                                                                                        </Button>

                                                                                                    </DataTemplate>
                                                                                                </ItemsControl.ItemTemplate>

                                                                                            </ItemsControl>

                                                                                        </StackPanel>

                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>

                                                                            </ItemsControl>

                                                                        </StackPanel>

                                                                    </Border>

                                                                    <Expander
                                                                        Header="Lista accesible de aspectos"
                                                                        IsExpanded="False">

                                                                        <ListBox
                                                                            Name="NatalAspectMatrixList"
                                                                            MinWidth="300"
                                                                            ItemsSource="{Binding NatalPanels.Aspects.Cells}"
                                                                            SelectedItem="{Binding NatalPanels.SelectedAspectCell, Mode=TwoWay}"
                                                                            SelectionMode="Single"
                                                                            AutomationProperties.Name="Matriz de aspectos natales"
                                                                            AutomationProperties.HelpText="Usa las flechas para recorrer los aspectos. Escape limpia la selección.">

                                                                            <ListBox.ItemTemplate>
                                                                                <DataTemplate
                                                                                    x:DataType="reading:NatalAspectMatrixCell">

                                                                                    <Border
                                                                                        IsVisible="{Binding HasAspect}"
                                                                                        Padding="4,7"
                                                                                        BorderThickness="0,0,0,1"
                                                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                        AutomationProperties.Name="{Binding AccessibleName}"
                                                                                        AutomationProperties.HelpText="{Binding AccessibleName}"
                                                                                        ToolTip.Tip="{Binding AccessibleName}">

                                                                                        <Grid
                                                                                            ColumnDefinitions="*,Auto,1.2*,*,Auto"
                                                                                            ColumnSpacing="7">

                                                                                            <TextBlock
                                                                                                Grid.Column="0"
                                                                                                Text="{Binding ColumnObjectName}"
                                                                                                TextWrapping="Wrap" />

                                                                                            <TextBlock
                                                                                                Grid.Column="1"
                                                                                                Text="{Binding AspectSymbol}"
                                                                                                FontWeight="SemiBold" />

                                                                                            <TextBlock
                                                                                                Grid.Column="2"
                                                                                                Text="{Binding AspectName}"
                                                                                                TextWrapping="Wrap" />

                                                                                            <TextBlock
                                                                                                Grid.Column="3"
                                                                                                Text="{Binding RowObjectName}"
                                                                                                TextWrapping="Wrap" />

                                                                                            <TextBlock
                                                                                                Grid.Column="4"
                                                                                                Text="{Binding OrbText}" />

                                                                                        </Grid>

                                                                                    </Border>

                                                                                </DataTemplate>
                                                                            </ListBox.ItemTemplate>

                                                                        </ListBox>

                                                                    </Expander>

                                                                </StackPanel>

                                                            </ScrollViewer>

                                                        </TabItem>

                                                        <TabItem
                                                            Header="Distribución"
                                                            AutomationProperties.Name="Distribución">

                                                            <ScrollViewer
                                                                VerticalScrollBarVisibility="Auto"
                                                                HorizontalScrollBarVisibility="Disabled">

                                                                <StackPanel
                                                                    Margin="4"
                                                                    Spacing="10">

                                                                    <StackPanel
                                                                        Spacing="2">

                                                                        <TextBlock
                                                                            Text="Distribución factual"
                                                                            FontWeight="SemiBold" />

                                                                        <TextBlock
                                                                            Text="{Binding NatalPanels.Distribution.ProfileText}"
                                                                            FontSize="11"
                                                                            Opacity="0.72" />

                                                                    </StackPanel>

                                                                    <ItemsControl
                                                                        Name="NatalDistributionSections"
                                                                        ItemsSource="{Binding NatalPanels.Distribution.Sections}"
                                                                        AutomationProperties.Name="Distribución estructurada de la carta">

                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate
                                                                                x:DataType="panelvm:NatalDistributionSectionViewModel">

                                                                                <Border
                                                                                    Margin="0,0,0,8"
                                                                                    Padding="7"
                                                                                    BorderThickness="1"
                                                                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                    CornerRadius="4">

                                                                                    <StackPanel
                                                                                        Spacing="5">

                                                                                        <Grid
                                                                                            ColumnDefinitions="*,Auto"
                                                                                            ColumnSpacing="8">

                                                                                            <TextBlock
                                                                                                Grid.Column="0"
                                                                                                Text="{Binding Title}"
                                                                                                FontWeight="SemiBold"
                                                                                                TextWrapping="Wrap" />

                                                                                            <TextBlock
                                                                                                Grid.Column="1"
                                                                                                Text="{Binding StatusText}"
                                                                                                FontSize="10"
                                                                                                Opacity="0.75"
                                                                                                TextWrapping="Wrap" />

                                                                                        </Grid>

                                                                                        <ItemsControl
                                                                                            ItemsSource="{Binding Rows}">

                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate
                                                                                                    x:DataType="panelvm:NatalDistributionRowViewModel">

                                                                                                    <Grid
                                                                                                        Margin="0,2"
                                                                                                        ColumnDefinitions="1.15*,42,1.8*"
                                                                                                        ColumnSpacing="8"
                                                                                                        AutomationProperties.Name="{Binding AccessibleName}">

                                                                                                        <TextBlock
                                                                                                            Grid.Column="0"
                                                                                                            Text="{Binding Label}"
                                                                                                            TextWrapping="Wrap" />

                                                                                                        <TextBlock
                                                                                                            Grid.Column="1"
                                                                                                            Text="{Binding CountText}"
                                                                                                            FontWeight="SemiBold"
                                                                                                            HorizontalAlignment="Center" />

                                                                                                        <TextBlock
                                                                                                            Grid.Column="2"
                                                                                                            Text="{Binding ObjectsText}"
                                                                                                            FontSize="10"
                                                                                                            TextWrapping="Wrap"
                                                                                                            Opacity="0.78" />

                                                                                                    </Grid>

                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>

                                                                                        </ItemsControl>

                                                                                    </StackPanel>

                                                                                </Border>

                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>

                                                                    </ItemsControl>

                                                                    <Border
                                                                        Padding="7"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                        CornerRadius="4">

                                                                        <StackPanel
                                                                            Spacing="4">

                                                                            <TextBlock
                                                                                Text="Síntesis"
                                                                                FontWeight="SemiBold" />

                                                                            <ItemsControl
                                                                                ItemsSource="{Binding NatalPanels.Distribution.SynthesisLines}"
                                                                                AutomationProperties.Name="Síntesis factual de distribución">

                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock
                                                                                            Margin="0,2"
                                                                                            Text="{Binding}"
                                                                                            TextWrapping="Wrap" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>

                                                                            </ItemsControl>

                                                                        </StackPanel>

                                                                    </Border>

                                                                </StackPanel>

                                                            </ScrollViewer>

                                                        </TabItem>

                                                        <TabItem
                                                            Header="Resumen"
                                                            AutomationProperties.Name="Resumen">

                                                            <ScrollViewer
                                                                VerticalScrollBarVisibility="Auto"
                                                                HorizontalScrollBarVisibility="Disabled">

                                                                <StackPanel
                                                                    Margin="4"
                                                                    Spacing="8"
                                                                    AutomationProperties.Name="Resumen natal factual">

                                                                    <TextBlock
                                                                        Text="Resumen factual"
                                                                        FontWeight="SemiBold" />

                                                                    <Border
                                                                        Padding="7"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                        CornerRadius="4">

                                                                        <StackPanel
                                                                            Spacing="4">

                                                                            <TextBlock
                                                                                Text="{Binding NatalPanels.Summary.SunText}"
                                                                                TextWrapping="Wrap" />

                                                                            <TextBlock
                                                                                Text="{Binding NatalPanels.Summary.MoonText}"
                                                                                TextWrapping="Wrap" />

                                                                            <TextBlock
                                                                                Text="{Binding NatalPanels.Summary.AscendantText}"
                                                                                TextWrapping="Wrap" />

                                                                            <TextBlock
                                                                                Text="{Binding NatalPanels.Summary.MidheavenText}"
                                                                                TextWrapping="Wrap" />

                                                                        </StackPanel>

                                                                    </Border>

                                                                    <Border
                                                                        Padding="7"
                                                                        BorderThickness="1"
                                                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                        CornerRadius="4">

                                                                        <StackPanel
                                                                            Spacing="4">

                                                                            <TextBlock
                                                                                Text="{Binding NatalPanels.Summary.ElementText}"
                                                                                TextWrapping="Wrap" />

                                                                            <TextBlock
                                                                                Text="{Binding NatalPanels.Summary.ModalityText}"
                                                                                TextWrapping="Wrap" />

                                                                            <TextBlock
                                                                                Text="{Binding NatalPanels.Summary.HouseConcentrationText}"
                                                                                TextWrapping="Wrap" />

                                                                            <TextBlock
                                                                                Text="{Binding NatalPanels.Summary.RetrogradesText}"
                                                                                TextWrapping="Wrap" />

                                                                        </StackPanel>

                                                                    </Border>

                                                                    <StackPanel
                                                                        Spacing="4">

                                                                        <TextBlock
                                                                            Text="Aspectos principales"
                                                                            FontWeight="SemiBold" />

                                                                        <ItemsControl
                                                                            Name="NatalSummaryMainAspects"
                                                                            ItemsSource="{Binding NatalPanels.Summary.MainAspects}"
                                                                            AutomationProperties.Name="Aspectos principales del resumen">

                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate
                                                                                    x:DataType="reading:NatalSummaryAspectReadModel">

                                                                                    <TextBlock
                                                                                        Margin="0,2"
                                                                                        Text="{Binding Text}"
                                                                                        TextWrapping="Wrap"
                                                                                        AutomationProperties.Name="{Binding Text}" />

                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>

                                                                        </ItemsControl>

                                                                    </StackPanel>

                                                                </StackPanel>

                                                            </ScrollViewer>

                                                        </TabItem>

                                                    </TabControl>

                                                </Border>

                                                </StackPanel>

                                            </Grid>

                                            <TextBlock
                                                Text="{Binding SelectedNatalObjectText}"
                                                HorizontalAlignment="Center"
                                                Opacity="0.75" />

                                        </StackPanel>

                                    </Border>

                                    <Border
                                        Name="NatalPositionsPanel"
                                        IsVisible="{Binding HasNatalPlacements}"
                                        Padding="10"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        AutomationProperties.Name="Posiciones natales">

                                        <StackPanel
                                            Spacing="6">

                                            <TextBlock
                                                Text="Posiciones"
                                                FontSize="16"
                                                FontWeight="SemiBold" />

                                            <Grid
                                                ColumnDefinitions="2*,2*,*,*"
                                                ColumnSpacing="10">

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Text="Objeto"
                                                    FontWeight="SemiBold" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="Posición"
                                                    FontWeight="SemiBold" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    Text="Casa"
                                                    FontWeight="SemiBold" />

                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="Movimiento"
                                                    FontWeight="SemiBold" />

                                            </Grid>

                                            <ListBox
                                                Name="NatalPositionsLegacyList"
                                                ItemsSource="{Binding NatalPlacements}"
                                                SelectedItem="{Binding SelectedNatalPlacement, Mode=TwoWay}"
                                                MaxHeight="300"
                                                AutomationProperties.Name="Lista de posiciones natales">

                                                <ListBox.ItemTemplate>
                                                    <DataTemplate
                                                        x:DataType="vm:NatalPlacementRowViewModel">

                                                        <Grid
                                                            Margin="0,3"
                                                            ColumnDefinitions="2*,2*,*,*"
                                                            ColumnSpacing="10">

                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Text="{Binding ObjectName}"
                                                                TextWrapping="Wrap" />

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{Binding PositionText}" />

                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Text="{Binding HouseText}" />

                                                            <TextBlock
                                                                Grid.Column="3"
                                                                Text="{Binding MotionText}" />

                                                        </Grid>

                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>

                                            </ListBox>

                                        </StackPanel>

                                    </Border>

                                    <Border
                                        Name="NatalAspectsPanel"
                                        IsVisible="{Binding HasCurrentNatalChart}"
                                        Padding="10"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        AutomationProperties.Name="Aspectos natales">

                                        <StackPanel
                                            Spacing="6">

                                            <TextBlock
                                                Text="Aspectos"
                                                FontSize="16"
                                                FontWeight="SemiBold" />

                                            <TextBlock
                                                IsVisible="{Binding !HasNatalAspects}"
                                                Text="No hay aspectos V1 persistidos para esta carta."
                                                Opacity="0.65"
                                                TextWrapping="Wrap" />

                                            <ItemsControl
                                                IsVisible="{Binding HasNatalAspects}"
                                                ItemsSource="{Binding NatalAspects}">

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate
                                                        x:DataType="vm:NatalAspectRowViewModel">

                                                        <Grid
                                                            Margin="0,3"
                                                            ColumnDefinitions="*,*,*,Auto"
                                                            ColumnSpacing="8">

                                                            <TextBlock
                                                                Grid.Column="0"
                                                                Text="{Binding FirstObjectName}" />

                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{Binding AspectName}"
                                                                FontWeight="SemiBold" />

                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Text="{Binding SecondObjectName}" />

                                                            <TextBlock
                                                                Grid.Column="3"
                                                                Text="{Binding OrbText}"
                                                                Opacity="0.75" />

                                                        </Grid>

                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>
                            </Border>

                            <Border
                                Padding="16"
                                CornerRadius="6"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

                                <StackPanel Spacing="10">

                                    <TextBlock
                                        Text="Historial"
                                        FontSize="17"
                                        FontWeight="SemiBold" />

                                    <TextBlock
                                        IsVisible="{Binding !HasPersonHistory}"
                                        Text="Todavía no hay eventos relevantes."
                                        Opacity="0.65" />

                                    <ItemsControl
                                        IsVisible="{Binding HasPersonHistory}"
                                        ItemsSource="{Binding PersonHistory}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="vm:PersonHistoryRowViewModel">

                                                <Grid
                                                    Margin="0,4"
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="12">

                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{Binding WhenText}"
                                                        Opacity="0.65" />

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding Summary}"
                                                        TextWrapping="Wrap" />

                                                </Grid>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>
                            </Border>

                            <TextBlock
                                IsVisible="{Binding HasError}"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />

                            <Grid
                                ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                ColumnSpacing="10">

                                <Button
                                    Grid.Column="0"
                                    Content="Guardar"
                                    Command="{Binding SaveCommand}" />

                                <Button
                                    Grid.Column="1"
                                    Content="{Binding CancelButtonText}"
                                    AutomationProperties.Name="Cancelar edición"
                                    Command="{Binding CancelCommand}" />

                                <Button
                                    Grid.Column="3"
                                    Content="Registrar consulta ahora"
                                    Command="{Binding SetConsultationNowCommand}" />

                                <Button
                                    Grid.Column="4"
                                    Content="{Binding DeleteButtonText}"
                                    AutomationProperties.Name="Eliminar persona"
                                    Command="{Binding DeleteCommand}" />

                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>

        <Border
            Grid.Row="2"
            Padding="20,8"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">

            <Grid
                ColumnDefinitions="*,Auto">

                <TextBlock
                    Grid.Column="0"
                    Text="{Binding StatusMessage}" />

                <TextBlock
                    Grid.Column="1"
                    Text="Fase 6 · Personas y carta natal"
